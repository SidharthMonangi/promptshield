# ── Server-only (never prefix these with VITE_) ─────────────────────
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional. Check https://console.groq.com/docs/models for current model IDs.
GROQ_MODEL=openai/gpt-oss-20b
# Set to 1 to use a fake model (no key needed) for offline demos.
PROMPTSHIELD_MOCK=0

# ── Browser (optional: enables sign-in and scan history) ───────────
# Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
